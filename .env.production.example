# Copy to .env.production on the server only; chmod 600 .env.production.
# Use separate directories, credentials, names and ports for each environment.
COMPOSE_PROJECT_NAME=app-production
APP_DOMAIN=app.example.com
HTTP_PORT=80
HTTPS_PORT=443
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=31536000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Generate a URL-safe password; Compose constructs DATABASE_URL from these values.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Compose supplies this URL for its private Redis cache service.
REDIS_URL=redis://redis:6379/1

# Configure a real SMTP service before implementing password resets or email delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@app