# Copy to .env for local development. Never reuse these settings in production.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO
DJANGO_DEBUG_TOOLBAR=true

# Native development uses SQLite. Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=local-development-only

# Optional for native development; Compose supplies redis://redis:6379/1.
# Start with: docker compose up -d --wait redis
# Then set REDIS_URL=redis://127.0.0.1:6379/1 to enable Redis in native Django.
REDIS_URL=